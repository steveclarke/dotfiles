# Dotfiles configuration template
# Copy this file to ~/.dotfilesrc and adjust settings for your machine

# Core
export DOTFILES_DIR=${HOME}/.local/share/dotfiles

# SSH Configuration
# GitHub user whose public keys (https://github.com/<user>.keys) get appended
# to ~/.ssh/authorized_keys so existing machines can SSH into this one.
export DOTFILES_GITHUB_USER=steveclarke
# SSH private keys are read out of 1Password, which ships with Omarchy and is
# always reachable — a new machine needs a 1Password login and nothing else.
# Turn on 1Password > Settings > Developer > Integrate with 1Password CLI first.
#
# Maps each key name in ~/.ssh to its 1Password item. Item ids, not titles:
# stable, and no spaces to quote around. Find them with:
#   op item list --categories "SSH Key"
export DOTFILES_SSH_KEYS_OP="sevenview2020=op://Employee/phmppr6yos4vik6wvpee4pi5he sevenview=op://Employee/sa2dxzebwhnuyhmprtt4g3or7i"
export DOTFILES_SSH_KEYS_PRIMARY=sevenview2020

# Git Configuration
# Set your Git user information
export DOTFILES_GIT_USER_NAME=Steve Clarke
export DOTFILES_GIT_USER_EMAIL=steve@sevenview.ca

# GUI applications (set to true to install GUI apps on both macOS and Linux)
export DOTFILES_INSTALL_GUI=true

# Android SDK baseline (set to true to have `setups/android-sdk.sh` run
# `android sdk install` with DOTFILES_ANDROID_SDK_PACKAGES on install/update).
# Requires `dotfiles install android-cli` (and jdk on Arch) first.
export DOTFILES_INSTALL_ANDROID_SDK=false
# export DOTFILES_ANDROID_SDK_PACKAGES="platform-tools platforms/android-36 build-tools/36.0.0"

# Platform-specific settings

# Optional: Platform-specific environment variables
# macOS:
# export HOMEBREW_NO_ANALYTICS=1
# export HOMEBREW_NO_INSECURE_REDIRECT=1

# Linux:
# polybar (set to true if you want polybar installed)
# export DOTFILES_CONFIG_POLYBAR=true 
# i3 window manager (set to true if you want i3 installed)
# export DOTFILES_CONFIG_I3=false

# =============================================================================
# SECRETS AND API KEYS
# =============================================================================
# This section is for storing secrets, API keys, tokens, and other sensitive
# environment variables. This file is NOT tracked in git and is safe for secrets.
# Both Fish and Zsh automatically source this file on startup.

# Example:
# export MY_API_KEY="your-secret-key-here"

# Toggl
# export TOGGL_API_TOKEN=
# export TOGGL_DEFAULT_WORKSPACE_ID=
# export TOGGL_DEFAULT_PROJECT_ID=
# export TOGGL_TIMEZONE=America/St_Johns

# Unio CLI
# Configure Unio CLI to use 1Password for Docker registry authentication.
# All settings use 1Password op:// references to securely store credentials.
#
# GitHub Container Registry (GHCR):
# export UNIO_OP_DOCKER_GHCR_USERNAME_REF="op://Employee/Github/login"
# export UNIO_OP_DOCKER_GHCR_TOKEN_REF="op://Employee/Github/my4b6euepsrgn6v24es73u7eau"
#
# Docker Hub (docker.io):
# export UNIO_OP_DOCKER_HUB_USERNAME_REF="op://Employee/Docker Hub/Username"
# export UNIO_OP_DOCKER_HUB_TOKEN_REF=
#
# Control:
# Set to skip 1Password entirely for Unio / 1Password Docker tokens
# export UNIO_OP_SKIP=1
