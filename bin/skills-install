#!/usr/bin/env bash
#
# skills-install — Sync all global skills from configured sources
#
# Installs or refreshes skills non-interactively across the agents listed in
# SKILL_AGENTS (Claude Code, Codex, OpenCode, etc.) using symlinks (default
# behavior of skills.sh).
#
# This file is the master list for every machine. After a full install, any
# skill in ~/.agents/skills that this run did not install is removed, along
# with its agent links. That covers skills dropped from a source repo, sources
# removed from this file, and skills added by hand or by another tool.
# Symlinks that point outside ~/.agents/skills (Omarchy's bundled skills) are
# left alone. To keep a skill on every machine, add it here.
#
# Usage:
#   skills-install          # sync all skills from all sources
#   skills-install --list   # list available skills without installing

set -euo pipefail

if [[ -z "${DOTFILES_DIR:-}" && -f "${HOME}/.dotfilesrc" ]]; then
  source "${HOME}/.dotfilesrc"
fi

if [[ -z "${DOTFILES_DIR:-}" ]]; then
  DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

source "${DOTFILES_DIR}/lib/dotfiles.sh"

LIST_ONLY=false
if [[ "${1:-}" == "--list" || "${1:-}" == "-l" ]]; then
  LIST_ONLY=true
fi

# Every `skills add` stamps updatedAt in the lock, even when nothing changed.
# Anything not stamped after this moment was not installed by this run.
RUN_STARTED="$(node -e 'console.log(new Date().toISOString())')"

# Agents to install skills into. By default only the agents Steve actually uses,
# instead of all ~70 agents skills.sh knows about. Override with a
# space-separated list in DOTFILES_SKILL_AGENTS, or set it to "*" for all agents.
read -ra SKILL_AGENTS <<< "${DOTFILES_SKILL_AGENTS:-claude-code codex opencode gemini-cli cursor}"

install_all() {
  local label="$1"
  local source="$2"
  echo ""
  echo "=== ${label}: ${source}"
  echo ""
  if [[ "$LIST_ONLY" == "true" ]]; then
    npx -y skills add "$source" -g -l
  else
    npx -y skills add "$source" -g -y -s '*' -a "${SKILL_AGENTS[@]}"
  fi
}

install_specific() {
  local label="$1"
  local source="$2"
  shift 2
  local skills=("$@")
  echo ""
  echo "=== ${label}: ${source} (${#skills[@]} skills)"
  echo ""
  if [[ "$LIST_ONLY" == "true" ]]; then
    npx -y skills add "$source" -g -l
  else
    for skill in "${skills[@]}"; do
      npx -y skills add "$source" -g -y -s "$skill" -a "${SKILL_AGENTS[@]}"
    done
  fi
}

# ─── My custom skills (dotfiles repo) — install all ──────────────────────────
install_all "My skills (dotfiles)" \
  "https://github.com/steveclarke/dotfiles/tree/master/ai/skills"

# ─── My skills from own repos — install all ──────────────────────────────────
install_all "My skills (outport)" \
  "https://github.com/steveclarke/outport/tree/master/skills"

install_all "My skills (outport-app)" \
  "https://github.com/myunio/outport-app/tree/master/skills"

install_all "My skills (nj)" \
  "https://github.com/steveclarke/nj/tree/master/skills"

install_all "My skills (kiso)" \
  "https://github.com/steveclarke/kiso/tree/master/skills"

install_all "My skills (superthread)" \
  "https://github.com/steveclarke/superthread/tree/master/skills"

install_all "My skills (ucmix)" \
  "https://github.com/steveclarke/ucmix/tree/master/skills"

install_all "My skills (real-world-rails)" \
  "https://github.com/steveclarke/real-world-rails/tree/main/skills"

# ─── External: pbakaus/impeccable — install all ──────────────────────────────
install_all "External (impeccable)" \
  "pbakaus/impeccable"

# ─── External: wbso-ai/omarchy-plugin-security-skill — install all ──────────
install_all "External (omarchy-plugin-security)" \
  "wbso-ai/omarchy-plugin-security-skill"

# ─── External: specific skills only ─────────────────────────────────────────

install_specific "External (antfu)" "antfu/skills" \
  slidev nuxt vue-best-practices vue-testing-best-practices

install_specific "External (nuxt)" "nuxt/ui" \
  nuxt-ui

install_specific "External (vueuse)" "vueuse/skills" \
  vueuse-functions

install_specific "External (maquina-app)" "maquina-app/rails-upgrade-skill" \
  rails-upgrade-assistant

install_specific "External (intellectronica)" "intellectronica/agent-skills" \
  gog-cli

install_specific "External (doist)" "doist/todoist-cli" \
  todoist-cli

install_specific "External (herdr)" "herdrdev/herdr" \
  herdr

install_specific "External (cloudflare)" "cloudflare/security-audit-skill" \
  security-audit

install_specific "External (typesafe)" "typesafe-ai/skills" \
  typesafe-ai

install_specific "External (hermes)" "NousResearch/hermes-agent" \
  hermes-agent

# Planning half only. The superpowers plugin stays off in managed-settings.json:
# its execution skills cost too many tokens.
install_specific "External (superpowers)" "obra/superpowers" \
  brainstorming writing-plans

# ─── Post-install: remove skills this run did not install ────────────────────
# `set -e` stops the script if any source fails, so a partial run never prunes.
prune_unlisted() {
  local skills_dir="${HOME}/.agents/skills"
  local lock="${HOME}/.agents/.skill-lock.json"
  [[ -d "$skills_dir" && -f "$lock" ]] || return 0

  echo ""
  echo "=== Removing skills not in this list ==="
  echo ""

  # Prints stale names: "dir<TAB>name" for installed folders, "lock<TAB>name"
  # for lock entries with no folder. Lock keys can be display names, so they
  # are compared in the folder-name form skills.sh uses.
  local stale
  stale="$(node -e '
    const fs = require("fs"), path = require("path");
    const [lock, dir, started] = process.argv.slice(1);
    const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    const data = JSON.parse(fs.readFileSync(lock, "utf8"));
    const entries = data.skills || {};
    const fresh = new Set(Object.keys(entries)
      .filter((k) => (entries[k].updatedAt || "") >= started).map(slug));
    if (fresh.size === 0) { console.error("nothing installed this run; not pruning"); process.exit(0); }
    const realDir = fs.realpathSync(dir);
    for (const name of fs.readdirSync(dir)) {
      if (fresh.has(slug(name))) continue;
      const p = path.join(dir, name);
      if (fs.lstatSync(p).isSymbolicLink()) {
        let target = "";
        try { target = fs.realpathSync(p); } catch {}
        if (target && !target.startsWith(realDir + path.sep)) continue;
      }
      console.log("dir\t" + name);
    }
    for (const key of Object.keys(entries)) {
      if (!fresh.has(slug(key)) && !fs.existsSync(path.join(dir, key))) console.log("lock\t" + key);
    }
  ' "$lock" "$skills_dir" "$RUN_STARTED")"

  local kind name
  while IFS=$'\t' read -r kind name; do
    [[ -n "$name" ]] || continue
    echo "  ✗ ${name}"
    # </dev/null: npx otherwise reads the rest of the list from stdin.
    npx -y skills remove -g -y "$name" </dev/null >/dev/null 2>&1 || true
    if [[ "$kind" == "dir" ]]; then
      rm -rf "${skills_dir:?}/${name}"
    fi
  done <<< "$stale"

  # Drop lock entries the remove command did not clear.
  node -e '
    const fs = require("fs"), path = require("path");
    const [lock, dir, started] = process.argv.slice(1);
    const data = JSON.parse(fs.readFileSync(lock, "utf8"));
    for (const [k, v] of Object.entries(data.skills || {})) {
      if ((v.updatedAt || "") < started) delete data.skills[k];
    }
    fs.writeFileSync(lock, JSON.stringify(data, null, 2) + "\n");
  ' "$lock" "$skills_dir" "$RUN_STARTED"

  # Remove agent links left pointing at deleted skills.
  local agent_dir link
  for agent_dir in "$HOME/.claude/skills" "$HOME/.codex/skills" "$HOME/.cursor/skills" \
    "$HOME/.gemini/skills" "$HOME/.config/opencode/skill" "$HOME/.config/opencode/skills"; do
    [[ -d "$agent_dir" ]] || continue
    for link in "$agent_dir"/*; do
      [[ -L "$link" && ! -e "$link" ]] || continue
      [[ "$(readlink "$link")" == *".agents/skills/"* ]] && rm -f "$link"
    done
  done
}

if [[ "$LIST_ONLY" != "true" ]]; then
  prune_unlisted
fi

# ─── Post-install: restore deps for skills that ship a package.json ──────────
# `skills add` overwrites each skill directory on every run, which wipes any
# node_modules. Reinstall deps for any skill that needs them (e.g. md-to-pdf)
# so a re-sync never leaves a skill broken.
if [[ "$LIST_ONLY" != "true" ]]; then
  echo ""
  echo "=== Installing skill dependencies (npm) ==="
  echo ""
  while IFS= read -r pkg; do
    dir="$(dirname "$pkg")"
    echo "  → $(basename "$dir")"
    # A Homebrew libvips (pulled in by other formulae) makes sharp build from
    # source, which fails; use sharp's bundled binaries instead.
    (cd "$dir" && SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm install --silent --no-audit --no-fund) \
      || echo "    ⚠ npm install failed in ${dir}"
  done < <(find "${HOME}/.agents/skills" -mindepth 2 -maxdepth 2 -name package.json 2>/dev/null)
fi

echo ""
echo "✓ Done. $(ls "${HOME}/.agents/skills" 2>/dev/null | wc -l | tr -d ' ') skills installed:"
echo ""
ls "${HOME}/.agents/skills"
