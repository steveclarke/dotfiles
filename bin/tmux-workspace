#!/usr/bin/env bash
#
# tmux-workspace — stand up a standard 4-window tmux session for a directory.
#
#   tmux-workspace <dir> [options]
#
# Windows: agent (shell, or an agent if --agent), cli, dev (runs the dev
# command), git (lazygit). Convention-based, with an optional flat-TOML config
# at ~/.config/worktree/config.toml (or a repo-local .worktree.toml) under a
# [session] table: default_agent, agent_mode, dev_cmd, git_window.
#
# Precedence: flags > repo config > global config > convention defaults.
#
# Options:
#   --name NAME            session name (default: basename of <dir>)
#   --agent claude|codex|none  launch an agent in window 1 (default: none)
#   --mode STR             raw extra args appended to the agent launch
#   --dev CMD              dev-stack command (default: bin/dev if executable)
#   --no-git               skip the lazygit window
#   --no-switch            create detached; don't switch/attach (agents use this)
#   --json                 print session + pane ids as JSON (agents use this)
#   --dry-run              print the resolved plan and exit; touch nothing
#   -h, --help

set -euo pipefail

# shellcheck disable=SC2034
GLOBAL_CONFIG="${TMUX_WORKSPACE_CONFIG:-$HOME/.config/worktree/config.toml}"
# shellcheck disable=SC2034,SC2016
SHIMS_EXPORT='export PATH="$HOME/.local/share/mise/shims:$PATH"'

TARGET_DIR=""
NAME=""
AGENT=""          # "" = unset -> config default -> none
AGENT_MODE=""
DEV_CMD=""        # "" = unset -> config -> discover
GIT_WINDOW=""     # "" = auto (config or lazygit); --no-git sets "false"
SWITCH="true"
JSON="false"
DRY_RUN="false"

# shellcheck disable=SC2034
PANE_AGENT="" PANE_CLI="" PANE_DEV="" PANE_GIT=""

usage() { sed -n '2,25s/^# \{0,1\}//p' "$0"; }

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)      NAME="${2:?--name requires a value}"; shift 2 ;;
      --name=*)    NAME="${1#*=}"; shift ;;
      --agent)     AGENT="${2:?--agent requires a value}"; shift 2 ;;
      --agent=*)   AGENT="${1#*=}"; shift ;;
      --mode)      AGENT_MODE="${2:?--mode requires a value}"; shift 2 ;;
      --mode=*)    AGENT_MODE="${1#*=}"; shift ;;
      --dev)       DEV_CMD="${2:?--dev requires a value}"; shift 2 ;;
      --dev=*)     DEV_CMD="${1#*=}"; shift ;;
      --no-git)    GIT_WINDOW="false"; shift ;;
      --no-switch) SWITCH="false"; shift ;;
      --json)      JSON="true"; shift ;;
      --dry-run)   DRY_RUN="true"; shift ;;
      -h|--help)   usage; exit 0 ;;
      -*)  echo "tmux-workspace: unknown flag: $1" >&2; exit 2 ;;
      *)   [[ -n "$TARGET_DIR" ]] && { echo "tmux-workspace: too many positional args" >&2; exit 2; }
           TARGET_DIR="$1"; shift ;;
    esac
  done
  [[ -n "$TARGET_DIR" ]] || { echo "tmux-workspace: target directory required" >&2; exit 2; }
  TARGET_DIR="$(cd "$TARGET_DIR" 2>/dev/null && pwd)" \
    || { echo "tmux-workspace: no such directory" >&2; exit 2; }
}

print_plan() {
  echo "target=$TARGET_DIR"
  echo "name=$NAME"
  echo "agent=$AGENT"
  echo "mode=$AGENT_MODE"
  echo "dev_cmd=$DEV_CMD"
  echo "git_window=$GIT_WINDOW"
  echo "switch=$SWITCH"
  echo "json=$JSON"
}

resolve_config() {
  # Filled in Task 2/3. Minimal defaults so Task 1 is runnable.
  [[ -z "$NAME" ]] && NAME="$(basename "$TARGET_DIR")"
  [[ -z "$AGENT" ]] && AGENT="none"
  [[ -z "$GIT_WINDOW" ]] && GIT_WINDOW="false"
}

main() {
  parse_args "$@"
  resolve_config
  if [[ "$DRY_RUN" == "true" ]]; then print_plan; exit 0; fi
  echo "tmux-workspace: session build not implemented yet" >&2; exit 1
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then main "$@"; fi
