#!/usr/bin/env bash
#
# voxkick - hard-restart voxtype.
#
# voxtype has no SIGTERM handler (still true as of 0.7.5), so
# `systemctl --user restart voxtype` blocks for the full 90s stop timeout
# before systemd resorts to SIGKILL. This skips that wait.
#
# Reach for it when dictation stops responding. The daemon can wedge with its
# main thread spinning at 100% CPU, at which point it answers nothing and only
# a KILL clears it. Quick tell: if `systemctl --user status voxtype` shows CPU
# time roughly equal to uptime, it is spinning.

set -e -o pipefail

echo "Killing voxtype..."
systemctl --user kill -s KILL voxtype || true
sleep 1

echo "Starting voxtype..."
systemctl --user start voxtype

# Give the daemon a moment to load the model before reporting back.
sleep 2

if systemctl --user is-active --quiet voxtype; then
  echo "voxtype: active"
else
  echo "voxtype: failed to start" >&2
  systemctl --user status voxtype --no-pager | head -20 >&2
  exit 1
fi
