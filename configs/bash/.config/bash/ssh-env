# Environment for non-interactive bash, chiefly `ssh host '<command>'`.
# Sourced from the top of ~/.bashrc, ahead of the interactive-shell early
# return, by configs/stow.sh. Idempotent.
#
# Two things such a shell lacks:
#  - pam_env (Omarchy's install/config/ssh-command-path.sh) sets PATH with the
#    mise shims AFTER /usr/bin, so system Ruby shadows mise's. Shims go first.
#  - /etc/profile.d/locale.sh runs only for login shells, so LANG is unset
#    (POSIX locale) and Ruby reads UTF-8 files as US-ASCII.

_mise_shims="$HOME/.local/share/mise/shims"
if [[ -d "$_mise_shims" ]]; then
  PATH=":${PATH}:"
  PATH="${PATH//:${_mise_shims}:/:}"
  PATH="${PATH#:}"
  PATH="${PATH%:}"
  export PATH="${_mise_shims}${PATH:+:$PATH}"
fi
unset _mise_shims

if [[ -z "${LANG:-}" ]]; then
  [[ -r /etc/locale.conf ]] && . /etc/locale.conf
  export LANG="${LANG:-C.UTF-8}"
fi
