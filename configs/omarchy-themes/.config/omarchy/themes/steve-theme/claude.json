{
  "_comment": [
    "Dark Claude Code theme (Catppuccin Mocha) against this theme's light desktop.",
    "Omarchy 4 renders claude.json from default/themed/claude.json.tpl using",
    "colors.toml, which is Latte here, so Claude Code came out light inside a dark",
    "terminal. Claude Code runs in the terminal, so it follows the terminal's",
    "Mocha palette, not the desktop's Latte one. A theme-supplied file is used",
    "verbatim instead of being generated.",
    "Keep in sync with foot.ini, alacritty.toml, ghostty.conf and kitty.conf."
  ],
  "name": "Omarchy",
  "base": "dark",
  "overrides": {
    "claude": "#89b4fa",
    "claudeShimmer": "#6e97d8",
    "text": "#cdd6f4",
    "inverseText": "#1e1e2e",
    "inactive": "#7f849c",
    "inactiveShimmer": "#6c7086",
    "subtle": "#585b70",
    "suggestion": "#94e2d5",
    "permission": "#89b4fa",
    "permissionShimmer": "#6e97d8",
    "remember": "#f9e2af",
    "success": "#a6e3a1",
    "error": "#f38ba8",
    "warning": "#f9e2af",
    "warningShimmer": "#d4b975",
    "merged": "#f5c2e7",
    "promptBorder": "#89b4fa",
    "promptBorderShimmer": "#6e97d8",
    "planMode": "#94e2d5",
    "autoAccept": "#f9e2af",
    "bashBorder": "#f9e2af",
    "ide": "#94e2d5",
    "diffAdded": "#2a3a2e",
    "diffRemoved": "#3d2b33",
    "diffAddedDimmed": "#24302a",
    "diffRemovedDimmed": "#33262c",
    "diffAddedWord": "#3f5c42",
    "diffRemovedWord": "#6b3a48",
    "userMessageBackground": "#313244",
    "userMessageBackgroundHover": "#3a3c4e",
    "bashMessageBackgroundColor": "#313244",
    "memoryBackgroundColor": "#313244",
    "selectionBg": "#f5e0dc",
    "rate_limit_fill": "#89b4fa",
    "rate_limit_empty": "#45475a",
    "briefLabelYou": "#f9e2af",
    "briefLabelClaude": "#89b4fa"
  }
}
